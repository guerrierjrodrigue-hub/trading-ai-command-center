# =========================================================================
#  TRADING AI COMMAND CENTER — Environment variables
#  Copy this file to `.env` and fill in the values.
#  NEVER commit `.env`. Only `.env.example` belongs in Git.
# =========================================================================

# ---- Runtime ----
NODE_ENV=development

# ---- Database (PostgreSQL) ----
# When running via docker compose, host is the service name `db`.
# When running locally against a local Postgres, use localhost.
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=trading_ai
DATABASE_URL=postgresql://trading:change_me_in_production@db:5432/trading_ai?schema=public

# ---- Auth ----
# 32+ char random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=please_generate_a_long_random_secret_at_least_32_chars
# Cookie name and session lifetime (seconds). 7 days by default.
SESSION_MAX_AGE=604800
# Multi-user controls. The FIRST account created is always the admin.
# Set to false to close signups; set an invite code to gate them.
ALLOW_REGISTRATION=true
SIGNUP_INVITE_CODE=

# ---- AI provider (pluggable) ----
# One of: mock | openai | anthropic | ollama
# `mock` requires NO api key and makes the whole app work offline.
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
# Base URL only needed for self-hosted / ollama. Example: http://localhost:11434
AI_BASE_URL=
# --- Local LLM with Ollama (real AI, 100% offline, no API key) ---
# 1. Install Ollama, then: `ollama pull llama3.1`
# 2. Set:  AI_PROVIDER=ollama   AI_MODEL=llama3.1
# 3. In Docker, the host Ollama is reachable at:
#    AI_BASE_URL=http://host.docker.internal:11434

# ---- Market data provider (pluggable) ----
# One of: mock | coingecko | twelvedata | oanda | live
#   mock        -> deterministic simulation, no key (default)
#   coingecko   -> real CRYPTO (BTC, ETH…), no key needed; rest simulated
#   twelvedata  -> real STOCKS/ETF (needs STOCKS_API_KEY); rest simulated
#   oanda       -> real FOREX + GOLD (needs OANDA_* below); rest simulated
#   live        -> real EVERYWHERE: crypto via CoinGecko + stocks via Twelve Data
#                  + forex/gold via OANDA
# Anything a live source can't serve automatically falls back to simulation.
MARKET_PROVIDER=mock
# Optional CoinGecko demo key (crypto works without it).
MARKET_API_KEY=
MARKET_BASE_URL=
# Free Twelve Data key for real stocks/ETF — get one at twelvedata.com
# (free tier: 8 req/min, 800/day). Required only for `twelvedata` or `live`.
STOCKS_API_KEY=

# ---- OANDA (free forex + gold data, practice/demo account) ----
# Real EUR/USD, GBP/USD, USD/JPY, USD/CAD and GOLD (XAU/USD) data — free, with
# generous limits. Create a free PRACTICE account at oanda.com, then:
#   1. Generate a personal API token (Manage API Access).
#   2. Find your demo account id (format 101-xxx-xxxxxxx-001).
# Data only — this never places a real order. Required for `oanda` or `live`.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# practice = demo servers (api-fxpractice). Keep `practice`.
OANDA_ENV=practice

# ---- Paper trading defaults ----
PAPER_STARTING_CAPITAL=10000
PAPER_FEE_BPS=10          # simulated fee in basis points (10 = 0.10%)

# ---- Broker connection (Phase 3) ----
# Which brokerage the app connects to. One of: paper | binance | alpaca
#   paper   -> internal simulator (default; trade on the Paper Trading page)
#   binance -> Binance SPOT TESTNET (crypto demo, works in Canada, no KYC).
#              Get keys at https://testnet.binance.vision  (log in with GitHub)
#   alpaca  -> Alpaca paper (US; may be unavailable in some countries)
# A real broker here reads your DEMO account and places/closes orders with
# FICTIONAL money.
BROKER_PROVIDER=paper
BROKER_API_KEY=
BROKER_API_SECRET=
# Leave EMPTY to use the provider's default demo endpoint (Binance testnet /
# Alpaca paper). Only set a live host on purpose — real-money execution ALSO
# requires BROKER_TRADING_ENABLED=true.
BROKER_BASE_URL=
# MASTER SAFETY SWITCH for REAL (live-money) execution. Keep false.
BROKER_TRADING_ENABLED=false

# ---- Telegram notifications (Phase 3) ----
# Bot token from @BotFather. Leave empty to disable Telegram delivery.
# Secret — used server-side only. After setting it, open your bot, send /start,
# then click "Connecter" on the Settings page.
TELEGRAM_BOT_TOKEN=

# ---- App ----
APP_URL=http://localhost:3000
